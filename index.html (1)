<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ethan Vibes SUPER</title>
<meta name="theme-color" content="#075E54">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
body{background:#111b21;color:#e9edef;overflow:hidden}
.header{background:#202c33;padding:14px 16px;display:flex;align-items:center;justify-content:space-between}
.header h1{font-size:20px;font-weight:600}
.header h1 span{color:#25D366}
.tabs{display:flex;background:#202c33;border-bottom:1px solid #2a3942}
.tab{flex:1;text-align:center;padding:14px 0;font-size:14px;font-weight:600;color:#8696a0;border-bottom:3px solid transparent}
.tab.active{color:#25D366;border-color:#25D366}
.content{height:calc(100vh - 110px);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center}
.empty-icon{width:120px;height:120px;background:#182229;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px;font-size:48px}
.empty-title{font-size:22px;margin-bottom:8px}
.empty-sub{color:#8696a0;font-size:14px;line-height:1.4;max-width:300px}
.fab{position:fixed;bottom:28px;right:20px;width:56px;height:56px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;color:#111b21;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.5)}
.chat-list{width:100%;height:calc(100vh - 110px);overflow:auto}
.chat-item{display:flex;padding:12px 16px;gap:12px;border-bottom:1px solid #222d34}
.avatar{width:49px;height:49px;border-radius:50%;background:#2a3942;display:flex;align-items:center;justify-content:center;font-size:22px}
.chat-name{font-size:17px}
.chat-last{color:#8696a0;font-size:14px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;padding:20px;z-index:10}
.modal.open{display:flex}
.modal-box{background:#202c33;border-radius:12px;padding:20px;width:100%;max-width:340px}
.modal-box input{width:100%;padding:12px;border-radius:8px;border:none;background:#2a3942;color:#e9edef;margin-bottom:12px;outline:none}
.btn{padding:10px 18px;border-radius:20px;border:none;font-weight:600;cursor:pointer}
.btn-cancel{background:#2a3942;color:#e9edef}
.btn-create{background:#25D366;color:#111b21}
</style>
</head>
<body>
<div class="header"><h1>🇺🇬 Ethan Vibes <span>SUPER</span></h1><div>⋮</div></div>
<div class="tabs"><div class="tab active">CHATS</div><div class="tab">MUSIC</div><div class="tab">MY PROFILE</div></div>

<div id="chatList" class="chat-list" style="display:none"></div>

<div id="emptyState" class="content">
<div class="empty-icon">💬</div>
<div class="empty-title">No chats yet</div>
<div class="empty-sub">Tap + to start a new chat — just like real WhatsApp. This is now ONE app with empty chats!</div>
</div>

<div class="fab" onclick="openModal()">+</div>

<div id="modal" class="modal">
<div class="modal-box">
<h3 style="margin-bottom:12px">New Chat</h3>
<input id="chatName" placeholder="Chat name e.g. Kampala Vibes">
<input id="chatMsg" placeholder="First message">
<div style="display:flex;gap:10px;justify-content:flex-end">
<button class="btn btn-cancel" onclick="closeModal()">Cancel</button>
<button class="btn btn-create" onclick="createChat()">Create</button>
</div>
</div>
</div>

<script>
let chats = JSON.parse(localStorage.getItem('ev_chats')||'[]');
function render(){
 const list=document.getElementById('chatList');
 const empty=document.getElementById('emptyState');
 if(chats.length===0){list.style.display='none';empty.style.display='flex';return;}
 empty.style.display='none';list.style.display='block';
 list.innerHTML=chats.map(c=>`<div class="chat-item"><div class="avatar">${c.icon||'👤'}</div><div><div class="chat-name">${c.name}</div><div class="chat-last">${c.last}</div></div></div>`).join('');
}
function openModal(){document.getElementById('modal').classList.add('open')}
function closeModal(){document.getElementById('modal').classList.remove('open')}
function createChat(){
 const name=document.getElementById('chatName').value.trim();
 const msg=document.getElementById('chatMsg').value.trim()||'Hi! 👋';
 if(!name)return;
 chats.unshift({name,last:msg});localStorage.setItem('ev_chats',JSON.stringify(chats));
 document.getElementById('chatName').value='';document.getElementById('chatMsg').value='';
 closeModal();render();
}
render();
</script>
</body>
</html>